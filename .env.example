# ==============================================================================
# DocuNexa — Environment Configuration Template
# ==============================================================================
# NOTE: DocuNexa operates 100% client-side in the browser by default.
# All PDF parsing, AES-256 encryption, decryption, splitting, and slicing
# require ZERO API keys or backend servers.
#
# If deploying to a hosting provider (e.g. Vercel, Netlify, Docker),
# you can configure the optional variables below:
# ==============================================================================

# Application Base URL (used for canonical SEO meta tags and sitemaps)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Port configuration for custom Node.js server
PORT=3000

# Optional: Custom Node environment
NODE_ENV=development

# ==============================================================================
# Optional: Non-Intrusive Advertisement Configuration
# By default, ADS_ENABLED=false and no external scripts are loaded.
# ==============================================================================
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADS_PROVIDER=none
NEXT_PUBLIC_ADS_CLIENT_ID=

# ==============================================================================
# Supabase Configuration (Authentication, Profiles & Payment Orders Database)
# ==============================================================================
# Supabase Project URL (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Public Anonymous API Key (safe for client-side queries with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (SERVER-ONLY PRIVILEGED: NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# Alternative secret key alias
SUPABASE_SECRET_KEY=

# ==============================================================================
# Email Delivery Configuration (Password Recovery Emails)
# (SERVER-ONLY: NEVER prefix with NEXT_PUBLIC_)
# ==============================================================================
RESEND_API_KEY=
EMAIL_FROM=DocuNexa Security <security@docunexa.pro.et>

# ==============================================================================
# Protected First-Admin Setup (SERVER-ONLY)
# ==============================================================================
ADMIN_SETUP_KEY=

# ==============================================================================
# Bybit Direct USDT (Polygon PoS) Payment Configuration
# (SERVER-ONLY: NEVER prefix with NEXT_PUBLIC_ / NEVER commit real secrets)
# ==============================================================================
# Bybit API Key with read-only deposit query permission
BYBIT_API_KEY=

# Bybit API Secret for HMAC-SHA256 signature verification (SERVER-ONLY)
BYBIT_API_SECRET=

# Bybit USDT Polygon PoS Deposit Address (e.g. 0x...)
BYBIT_USDT_POLYGON_ADDRESS=

# Optional Bybit Account UID
BYBIT_UID=

# ==============================================================================
# Aptos Mainnet USDT (Tether Fungible Asset) Payment Configuration
# (SERVER-ONLY: Exact 64-character hex Aptos receiving address)
# Official Fungible Asset Metadata ID: 0x357b0b74bc833e95a115ad22604854d6b0fca151cecd94111770e5d6ffc9dc2b
# ==============================================================================
APTOS_USDT_ADDRESS=0xca9ea3f1167d11817d9ab02493c9a49a83d416bc3374f0872a7cc1ac79670bbd
# Optional custom indexer / node URLs (defaults to official Aptos mainnet endpoints)
APTOS_INDEXER_GRAPHQL_URL=https://api.mainnet.aptoslabs.com/v1/graphql
APTOS_NODE_URL=https://api.mainnet.aptoslabs.com/v1

